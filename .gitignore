# ===== 비밀값 / 환경 변수 =====
# 공개 저장소이므로 키가 한 번이라도 커밋되면 즉시 폐기해야 합니다.
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials.json

# ===== 파이썬 =====
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
dist/

# ===== 테스트 / 린트 캐시 =====
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== LLM 응답 캐시 (재생성 가능, 용량이 큼) =====
.cache/
*.langchain.db
llm_cache.sqlite*

# ===== 실행 로그 / 실험 산출물 =====
logs/
runs/
*.log

# 생성되는 HTML 검토 페이지 (scripts/build_review_page.py 로 언제든 다시 만듭니다)
build/*
# 단, 결과 보고 페이지는 직접 작성한 산출물이라 커밋합니다.
# build/results-page.html 은 여기서 생성하는 서버 배포용이라 커밋하지 않습니다
# (scripts/build_results_page.py 로 다시 만듭니다). 사본을 둘 두면 어긋납니다.
!build/results.html

# 주의: data/snapshots/ 의 주가 스냅샷은 평가 재현성을 위해 일부러 커밋합니다.
#       여기에 data/ 를 통째로 추가하지 마십시오.

# ===== 노트북 =====
.ipynb_checkpoints/

# ===== 에디터 / OS =====
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ===== 개인 검토 문서 =====
# 공개 저장소입니다. 받아 둔 검토 문서는 올리지 않습니다.
docs/*review*.md
