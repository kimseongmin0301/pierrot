# PIERROT 환경 변수 견본
#
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우십시오.
#   cp .env.example .env
#
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# 이 파일(.env.example)에는 절대 실제 키를 적지 마십시오.

# ---------- OpenAI (유료) ----------
OPENAI_API_KEY=

# 주장 분해 / 검증 판단 / LLM-as-judge 베이스라인에 사용
OPENAI_EXTRACTOR_MODEL=gpt-4o-mini
OPENAI_VERIFIER_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini

# ---------- Ollama (ai-server, 무료) ----------
# 서버의 Ollama 는 127.0.0.1 에만 바인딩되어 있으므로 SSH 터널을 먼저 엽니다.
#   ssh -N -L 11434:127.0.0.1:11434 ai-server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATOR_MODEL=gemma3:4b
OLLAMA_GENERATOR_ALT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# ---------- KRX 정보데이터시스템 (무료 회원가입) ----------
# https://data.krx.co.kr 에서 무료 가입
# 원주가(수정되지 않은 당시 실제 호가)를 받는 데만 사용합니다.
# 수집할 때만 필요하고, 검증은 저장된 스냅샷만 읽으므로 재현성에는 영향이 없습니다.
KRX_ID=
KRX_PW=

# ---------- DART 공시 API (무료) ----------
# https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=

# ---------- NLI 모델 (무료, 로컬 CPU) ----------
NLI_MODEL=Huffon/klue-roberta-base-nli
NLI_DEVICE=cpu

# ---------- LangSmith 트레이싱 (선택, 무료 티어) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pierrot

# ---------- 비용 가드 ----------
# 누적 비용이 이 값(USD)을 넘으면 실행을 중단합니다.
MONTHLY_BUDGET_USD=5.0
